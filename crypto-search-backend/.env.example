# ---------------------------------------------------------------
# CryptoSearch backend configuration
# Copy this file to `.env` and fill in the values.
# NEVER commit your real `.env` file.
# ---------------------------------------------------------------

# HTTP server
HOST=127.0.0.1
PORT=3001

# MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=CryptoSearchDevelopment

# Security (REQUIRED) - use long random strings, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=change-me
RSA_PRIVATE_KEY_PASSPHRASE=change-me

# Google Drive OAuth client credentials file (see google-api-credentials.example.json)
GOOGLE_CREDENTIALS_PATH=./google-api-credentials.json

# SMTP (used to email file-share notifications).
# Leave SMTP_USERNAME empty to use a temporary nodemailer (Ethereal) test account.
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
